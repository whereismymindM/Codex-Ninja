{
  "_说明": "技术选型决策模板（对抗型）——现实对应：调研→技术评审会（正反方陈述+CTO 裁决）。用法：替换 {角色X} → 改内容 → 喂 compose.js。",
  "_现实流程": "约束挖掘(双人对话) → 对抗辩论(正方×反方×裁判) → 收工",
  "_角色需求": ["{需求方}", "{技术方}", "{正方}", "{反方}", "{裁判}"],
  "项目": "技术选型决策",
  "角色": ["{需求方}", "{技术方}", "{正方}", "{反方}", "{裁判}"],
  "轮次": [
    {
      "模式": "双人对话",
      "角色": { "{需求方}": "问方", "{技术方}": "答方" },
      "任务": "约束挖掘：{需求方}挖清选型约束（规模/成本/团队/时间线），{技术方}答可行选项与边界。产出=约束清单。",
      "产出负责人": "{需求方}",
      "产出": "world/output/task001_约束/约束清单.md",
      "任务目录": "world/task001_约束/",
      "本轮后": { "{需求方}": "待命", "{技术方}": "待命", "{正方}": "待命", "{反方}": "待命", "{裁判}": "待命" }
    },
    {
      "模式": "辩论",
      "角色": { "{正方}": "正方", "{反方}": "反方", "{裁判}": "裁判" },
      "任务": "技术选型辩论：{正方}立论方案A，{反方}立论方案B，交叉找茬→自由辩论→双总结，{裁判}读全部材料给结论《选型结论》（逐条核验双方论点）。",
      "产出负责人": "{裁判}",
      "产出": "world/output/task002_选型/选型结论.md",
      "任务目录": "world/task002_选型/",
      "本轮后": { "{需求方}": "待命", "{技术方}": "待命", "{正方}": "待命", "{反方}": "待命", "{裁判}": "待命" }
    },
    { "模式": "收工" }
  ]
}
