{
  "_说明": "质量审计模板（终审型）——现实对应：多专家独立审→汇总裁决。用法：替换 {角色X} → 改内容 → 喂 compose.js。",
  "_现实流程": "多角色并行output/审计 → 终审交叉验证 → 收工",
  "_角色需求": ["{角色A}", "{角色B}", "{审计角色}"],
  "项目": "质量审计",
  "角色": ["{角色A}", "{角色B}", "{审计角色}"],
  "轮次": [
    {
      "模式": "单人输出",
      "角色": { "{角色A}": "单人", "{角色B}": "单人" },
      "任务": "并行output/自审：{角色A}、{角色B} 各自从自己视角审同一对象，产出独立审计意见（产出负责人=各自，各写一份）。",
      "产出负责人": "各自",
      "产出": "world/output/task001_审计/",
      "任务目录": "world/task001_审计/",
      "本轮后": { "{角色A}": "待命", "{角色B}": "待命", "{审计角色}": "待命" }
    },
    {
      "模式": "单人输出",
      "角色": { "{审计角色}": "单人" },
      "任务": "终审交叉验证：{审计角色} 读 {角色A}/{角色B} 的独立意见，逐条验证（不照单全收，标注误判/确认真问题/补遗漏），产出《终审结论》（P0/P1/P2 分级）。",
      "产出负责人": "{审计角色}",
      "产出": "world/output/task002_终审/终审结论.md",
      "任务目录": "world/task002_终审/",
      "本轮后": { "{角色A}": "待命", "{角色B}": "待命", "{审计角色}": "待命" }
    },
    { "模式": "收工" }
  ]
}
